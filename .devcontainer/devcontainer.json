{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.base.schema.json",
  "name": "RedrobDesign",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/redrob-design,type=bind,consistency=cached",
  "workspaceFolder": "/workspace/redrob-design",
  "remoteUser": "bun",
  "updateRemoteUserUID": true,
  "mounts": [
    "source=redrob-design-root-modules-${devcontainerId},target=/workspace/redrob-design/node_modules,type=volume",
    "source=redrob-design-scene-graph-modules-${devcontainerId},target=/workspace/redrob-design/packages/scene-graph/node_modules,type=volume",
    "source=redrob-design-pen-modules-${devcontainerId},target=/workspace/redrob-design/packages/pen/node_modules,type=volume",
    "source=redrob-design-kiwi-modules-${devcontainerId},target=/workspace/redrob-design/packages/kiwi/node_modules,type=volume",
    "source=redrob-design-fig-modules-${devcontainerId},target=/workspace/redrob-design/packages/fig/node_modules,type=volume",
    "source=redrob-design-core-modules-${devcontainerId},target=/workspace/redrob-design/packages/core/node_modules,type=volume",
    "source=redrob-design-dom-css-modules-${devcontainerId},target=/workspace/redrob-design/packages/dom-css/node_modules,type=volume",
    "source=redrob-design-vue-modules-${devcontainerId},target=/workspace/redrob-design/packages/vue/node_modules,type=volume",
    "source=redrob-design-cli-modules-${devcontainerId},target=/workspace/redrob-design/packages/cli/node_modules,type=volume",
    "source=redrob-design-mcp-modules-${devcontainerId},target=/workspace/redrob-design/packages/mcp/node_modules,type=volume",
    "source=redrob-design-docs-modules-${devcontainerId},target=/workspace/redrob-design/packages/docs/node_modules,type=volume",
    "source=redrob-design-docs-tool-modules-${devcontainerId},target=/workspace/redrob-design/tools/docs/node_modules,type=volume"
  ],
  "postCreateCommand": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git lfs pull; fi && bun install --frozen-lockfile",
  "containerEnv": {
    "TAURI_DEV_HOST": "0.0.0.0"
  },
  "forwardPorts": [1420],
  "portsAttributes": {
    "1420": {
      "label": "RedrobDesign web editor",
      "onAutoForward": "notify"
    }
  }
}
