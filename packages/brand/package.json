{
  "name": "@redrob-design/brand",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./fonts": "./src/fonts.ts",
    "./node": {
      "types": "./dist/node.d.ts",
      "bun": "./src/node.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "bun": "./src/preset.ts",
      "import": "./dist/preset.js",
      "default": "./dist/preset.js"
    },
    "./importer": {
      "types": "./dist/importer/index.d.ts",
      "bun": "./src/importer/index.ts",
      "import": "./dist/importer/index.js",
      "default": "./dist/importer/index.js"
    }
  },
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "test": "bun test src",
    "tokens": "bun src/cli/sync-tokens.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@redrob-labs/ui": "1.0.2",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  }
}
