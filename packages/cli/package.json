{
  "name": "@redrob-design/cli",
  "version": "0.14.0",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#cli/*": "./src/*"
  },
  "bin": {
    "redrob-design": "./bin/redrob-design.js"
  },
  "exports": {
    "./library": {
      "types": "./dist/library/index.d.mts",
      "bun": "./src/library/index.ts",
      "import": "./dist/library/index.mjs",
      "default": "./dist/library/index.mjs"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redrob-design/redrob-design.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@redrob-design/core": "workspace:*",
    "@redrob-design/dom-css": "workspace:*",
    "@redrob-design/mcp": "workspace:*",
    "@redrob-design/scene-graph": "workspace:*",
    "agentfmt": "^0.1.3",
    "canvaskit-wasm": "^0.41.1",
    "citty": "^0.1.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
