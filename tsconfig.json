{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["vite/client", "unplugin-icons/types/vue"],
    "paths": {
      "@/*": ["./src/*"],
      "@redrob-design/vue": ["./src/stubs/i18n.ts"],
      "@redrob-design/core/constants": ["./src/stubs/core-constants.ts"],
      "@redrob-labs/route-labeller": ["./src/stubs/route-labeller.ts"],
      "@/app/tauri/window": ["./src/stubs/tauri-window.ts"],
      "@/app/ai/insights": ["./src/stubs/ai-insights.ts"],
      "@/app/ai/model-guide": ["./src/stubs/ai-model-guide.ts"],
      "@/app/tabs": ["./src/stubs/tabs.ts"],
      "@/app/shell/command-palette": ["./src/stubs/shell-command-palette.ts"],
      "@/app/shell/menu/entry": ["./src/stubs/shell-menu-entry.ts"],
      "@/app/shell/menu/main-menu": ["./src/stubs/shell-main-menu.ts"],
      "@/app/ai/models": ["./src/stubs/ai-models.ts"],
      "@/app/settings/credentials/types": ["./src/stubs/settings-credentials-types.ts"],
      "@/app/ai/chat/storage": ["./src/stubs/ai-chat-connect.ts"],
      "@/app/ai/models/catalog": ["./src/stubs/ai-chat-connect.ts"],
      "@/app/ai/chat/connection-test": ["./src/stubs/ai-chat-connect.ts"],
      "@/app/ai/connect/app-connect": ["./src/stubs/ai-chat-connect.ts"],
      "@/app/ai/connect/device-connect": ["./src/stubs/ai-chat-connect.ts"]
    },
    "baseUrl": "."
  },
  "include": ["src", "env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
