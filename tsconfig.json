{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["vite/client", "unplugin-icons/types/vue"],
    "paths": {
      "@/*": ["./src/*"],
      "@redrob-design/vue": ["./src/stubs/i18n.ts"],
      "@redrob-design/core/constants": ["./src/stubs/core-constants.ts"],
      "@redrob-labs/route-labeller": ["./src/stubs/route-labeller.ts"],
      "@/app/tauri/window": ["./src/stubs/tauri-window.ts"]
    },
    "baseUrl": "."
  },
  "include": ["src", "env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
