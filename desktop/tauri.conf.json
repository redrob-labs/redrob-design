{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redrob Design",
  "version": "0.14.0",
  "identifier": "design.redrob.RedrobDesign",
  "build": {
    "beforeDevCommand": "bun run generate:tauri-menu && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run generate:tauri-menu && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Redrob Design",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pen"],
        "name": "Redrob Design File",
        "description": "Redrob Design file",
        "role": "Editor",
        "mimeType": "application/x-redrob-design",
        "rank": "Alternate"
      },
      {
        "ext": ["fig"],
        "name": "Figma Design File",
        "description": "Figma design file",
        "role": "Editor",
        "mimeType": "application/x-figma",
        "rank": "Alternate"
      }
    ],
    "macOS": {}
  }
}
