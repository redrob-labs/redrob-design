{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "updater:default",
    "process:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-html",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/Library/Application Support/RedrobDesign/mcp.json" },
        { "path": "$LOCALDATA/RedrobDesign/mcp.json" },
        { "path": "$RUNTIME/redrob-design/mcp.json" },
        { "path": "$HOME/.redrob-design/mcp.json" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME/Library/Application Support/RedrobDesign/mcp.json" },
        { "path": "$LOCALDATA/RedrobDesign/mcp.json" },
        { "path": "$RUNTIME/redrob-design/mcp.json" },
        { "path": "$HOME/.redrob-design/mcp.json" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [{ "path": "**" }]
    },
    "fs:allow-unwatch",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "redrob", "cmd": "redrob", "args": true },
        { "name": "bun", "cmd": "bun", "args": true },
        {
          "name": "redrob-design-mcp-http",
          "cmd": "redrob-design-mcp-http",
          "args": true
        },
        { "name": "cmd", "cmd": "cmd", "args": true }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
